{
  "expo": {
    "name": "SalesMaintain",
    "slug": "salesmaintain-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#047857"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salesmaintain.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#047857"
      },
      "package": "com.salesmaintain.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SalesMaintain to access your photos for uploading transaction images.",
          "cameraPermission": "Allow SalesMaintain to take photos for uploading transaction images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ebcf322e-be96-40d3-88b2-d13bf8871808"
      }
    },
    "owner": "35-hasib"
  }
}
